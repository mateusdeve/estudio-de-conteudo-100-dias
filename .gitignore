# ── Pessoal: fica só na máquina de cada um ─────────────────
canal/
brutos/*
exports/*
roteiros/*
projetos/*
!projetos/_ferramentas/
assets/*
!assets/sfx/
!**/.gitkeep

# ── Ferramentas: instaláveis, não versionar ────────────────
projetos/_ferramentas/node_modules/
projetos/_ferramentas/venv/
projetos/_ferramentas/modelos/
# dados e scripts de b-roll de cada vídeo são do canal
projetos/_ferramentas/broll-kit/dados/*
!projetos/_ferramentas/broll-kit/dados/exemplo.js
projetos/_ferramentas/broll-kit/gerar-*.sh

# ── Maestri: os .md dos papéis são gerados com caminhos locais ──
.maestri/*
!.maestri/roles/
.maestri/roles/*/*
!.maestri/roles/*/role.json

# ── Sistema ────────────────────────────────────────────────
.DS_Store
*.tmp
__pycache__/

# ── Remotion: dependências, links locais e dados de cada vídeo ──
**/node_modules/
projetos/_ferramentas/remotion/public/*
!projetos/_ferramentas/remotion/public/.gitkeep
projetos/_ferramentas/remotion/src/videos/*.json
!projetos/_ferramentas/remotion/src/videos/exemplo.json
projetos/_ferramentas/remotion/out/
